# Database Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dashboard
POSTGRES_PORT=5432

# SSL Mode (подключение к Postgres)
# disable — локальный Docker Postgres
# require — внешняя managed БД (RDS, Supabase и т.д.)
DB_SSLMODE=disable

# HTTPS: флаг Secure для auth-cookie (true при up-https на сервере)
# SECURE_COOKIE=false

# Порты nginx на хосте (опционально, defaults: 8080 / 8443)
# NGINX_PORT=8080
# NGINX_HTTPS_PORT=8443

# Jwt token
JWT_SECRET=4WpCMC6jsxV001CT7ZKPtlDl8hHAa+JyMXPnt09/6S4=

