include include.mk

.PHONY: help up down down-v build build-nc build-fast nginx-htpasswd prune

help:
	@echo "Полный стек (docker compose): Postgres → миграции → backend → frontend → nginx"
	@echo "  make -f Makefile.prod nginx-htpasswd HTPASSWD_USER=u HTPASSWD_PASS=p   — один раз, пароль basic-auth"
	@echo "  make -f Makefile.prod up          — поднять всё"
	@echo "  make -f Makefile.prod down        — остановить"
	@echo "  make -f Makefile.prod down-v      — остановить и удалить volume БД"
	@echo "  make -f Makefile.prod build       — пересобрать образы (с кешем)"
	@echo "  make -f Makefile.prod build-nc    — пересобрать без кеша"
	@echo "Откройте http://localhost:$${NGINX_PORT:-8080} или http://<IP_сервера>:$${NGINX_PORT:-8080}"
	@echo "команда для получения ip: ipconfig getifaddr en0"

up:
	docker-compose up -d

down:
	docker-compose down

# если надо очистить данные из базы (удаляет ваще все, иначе лучше использовать команду down)
down-v:
	docker-compose down -v --remove-orphans

build:
	docker-compose build

build-nc:
	docker-compose build --no-cache backend frontend migrations nginx

build-fast: build

nginx-htpasswd:
	@test -n "$(HTPASSWD_USER)" && test -n "$(HTPASSWD_PASS)" || (echo "HTPASSWD_USER и HTPASSWD_PASS обязательны" && false)
	@$(DOCKER) run --rm httpd:2-alpine htpasswd -nbB "$(HTPASSWD_USER)" "$(HTPASSWD_PASS)" > nginx/.htpasswd

prune:
	$(DOCKER) system prune -a --volumes
